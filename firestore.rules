rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function familyMember(fid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
    }
    function membersValid() {
      return request.resource.data.members is list
        && request.resource.data.members.size() >= 1
        && request.resource.data.members.size() <= 5
        && request.resource.data.owner in request.resource.data.members;
    }
    match /families/{fid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['owner', 'members', 'createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list, delete: if false;
      // Owner can add/revoke members, offer/cancel transfer; cannot remove self.
      allow update: if signedIn() && (
        (resource.data.owner == request.auth.uid
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'pendingOwner'])
          && membersValid()
          && request.auth.uid in request.resource.data.members
          && (
            !('pendingOwner' in request.resource.data)
            || (request.resource.data.pendingOwner is string
                && request.resource.data.pendingOwner != resource.data.owner
                && request.resource.data.pendingOwner in request.resource.data.members)
          )
        )
        ||
        // Only the designated member may accept the transfer. The offer is removed atomically.
        (('pendingOwner' in resource.data)
          && request.auth.uid == resource.data.pendingOwner
          && request.auth.uid in resource.data.members
          && request.resource.data.owner == request.auth.uid
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.members == resource.data.members
          && !('pendingOwner' in request.resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'pendingOwner'])
        )
      );
      match /shared/{docId} {
        allow get: if docId == 'state' && familyMember(fid);
        allow list, delete: if false;
        allow create: if docId == 'state' && familyMember(fid)
          && request.resource.data.keys().hasOnly(['data', 'revision', 'updatedAt', 'updatedBy'])
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.data is map
          && request.resource.data.get('revision', 0) == 0;
        allow update: if docId == 'state' && familyMember(fid)
          && request.resource.data.keys().hasOnly(['data', 'revision', 'updatedAt', 'updatedBy'])
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.data is map
          && request.resource.data.revision is int
          && request.resource.data.revision == resource.data.get('revision', 0) + 1;
      }
    }
  }
}

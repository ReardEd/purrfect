rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function familyMember(fid) {
      return signedIn() && request.auth.uid in get(/databases/$(database)/documents/families/$(fid)).data.members;
    }
    match /families/{fid} {
      allow create: if signedIn() && request.resource.data.keys().hasOnly(['owner','members','createdAt'])
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow list, delete: if false;
      allow update: if signedIn() && resource.data.owner == request.auth.uid
        && request.resource.data.owner == resource.data.owner
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members is list
        && request.resource.data.members.size() <= 5
        && request.resource.data.members.size() >= 1
        && request.auth.uid in request.resource.data.members;
      match /shared/{docId} {
        allow get: if docId == 'state' && familyMember(fid);
        allow list, delete: if false;
        allow create, update: if docId == 'state' && familyMember(fid)
          && request.resource.data.keys().hasOnly(['data','updatedAt','updatedBy'])
          && request.resource.data.updatedBy == request.auth.uid
          && request.resource.data.data is map;
      }
    }
  }
}
